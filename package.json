{
  "name": "relentless-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Experimental human-in-the-loop interview workspace for turning coding-agent conversations into reviewed, explicitly authorized execution prompts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadAlkadri/relentless.git"
  },
  "bin": {
    "relentless": "bin/relentless.mjs"
  },
  "scripts": {
    "start": "node bin/relentless.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.265",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.15",
    "katex": "0.18.7",
    "marked": "18.0.12",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
