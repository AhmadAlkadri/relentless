{
  "name": "relentless-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local Markdown space for thinking with agents",
  "bin": {
    "relentless": "bin/relentless.mjs"
  },
  "scripts": {
    "start": "node bin/relentless.mjs",
