    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.265",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.15",
    "marked": "18.0.12",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
